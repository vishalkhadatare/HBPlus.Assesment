rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isHbPlusDomain() {
      return isAuthenticated() && 
        request.auth.token.email.matches('.*@hbplus[.]fit$');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection: Only authenticated users with @hbplus.fit emails can read/write their own document
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isHbPlusDomain();
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

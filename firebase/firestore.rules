rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function inDomain() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@hbplus[.]fit$');
    }

    function isAdmin() {
      return inDomain() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'Admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin'
      );
    }

    function isOwner(uid) {
      return inDomain() && request.auth.uid == uid;
    }

    function canCreateOwnVerifiedDomainProfile(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@hbplus[.]fit$');
    }

    // Users Collection: Users view own profile; Admins list & manage all
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if canCreateOwnVerifiedDomainProfile(uid);
      allow update: if isAdmin()
                    || (isOwner(uid) && !('role' in request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if isAdmin();
    }

    // Immutable Audit Logs: Admins read; Server alone writes
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Diagnostics Collection: For sandbox connectivity verification
    match /diagnostics/{docId} {
      allow read, write: if true;
    }

    // Attendance & Check-in
    match /attendance/{attendanceId} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if (signedIn() && request.resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Leave Requests & Balances
    match /leaveRequests/{leaveId} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /leaveBalances/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // Company Resources (Shifts, Announcements, Tasks, Documents)
    match /shifts/{shiftId} {
      allow read: if inDomain();
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if inDomain();
      allow write: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read, write: if inDomain();
    }

    match /payslips/{payslipId} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /documents/{docId} {
      allow read: if inDomain();
      allow write: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if inDomain();
    }

    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

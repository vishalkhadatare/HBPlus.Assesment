# ==============================================================================
# HBPlus Secure Access Portal - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (apps/server)
# ------------------------------------------------------------------------------
NODE_ENV=development
API_PORT=5000

# Enforced Domain Restriction (exact normalized equality)
ALLOWED_EMAIL_DOMAIN=hbplus.fit

# CORS Allowed Origins (comma-separated for multi-client development)
CLIENT_ORIGIN=http://localhost:8081,http://localhost:3000,http://localhost:5173

# Comma-separated list of emails auto-provisioned as corporate administrators
ADMIN_EMAILS=admin@hbplus.fit

# Firebase Admin SDK Credentials
# Option 1: File path to downloaded Service Account JSON
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./serviceAccountKey.json

# Option 2: Inline Environment Variables
FIREBASE_PROJECT_ID=hbplus-secure-access
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@hbplus-secure-access.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC7...\n-----END PRIVATE KEY-----\n"

# Optional: Local Firebase Emulator Suite (set if running firebase emulators:start)
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIRESTORE_EMULATOR_HOST=localhost:8080


# ------------------------------------------------------------------------------
# Frontend Client Configuration (apps/client)
# ------------------------------------------------------------------------------
# Base URL for REST API (use http://10.0.2.2:5000/api for Android Emulator)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_ALLOWED_EMAIL_DOMAIN=hbplus.fit

# Firebase Web App Client SDK Configuration (Found in Firebase Console > Project Settings > General > Your Apps)
VITE_FIREBASE_API_KEY=AIzaSyA1B2C3D4E5F6G7H8I9J0K1L2M3N4O5P6Q
VITE_FIREBASE_AUTH_DOMAIN=hbplus-secure-access.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hbplus-secure-access
VITE_FIREBASE_STORAGE_BUCKET=hbplus-secure-access.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
